@host = http://localhost:8090
@lastPaymentId = 40a8b9b6-812a-40f7-a1e9-c59ff4e34fc1

// Payment Request
### GET request to actuator for prometheus metrics
GET {{host}}/payment/{{lastPaymentId}}

// ------------------------------------------------------------
// Successful Payment
// ------------------------------------------------------------

### POST send payment - Success
POST {{host}}/payment
Content-Type: application/json

< ./validPaymentAuthorized.json

### POST send payment - Success with Idempotency Key
POST {{host}}/payment
Content-Type: application/json
Idempotency-Key: test-key-12345

< ./validPaymentAuthorized.json

// ------------------------------------------------------------
// Failed Payment
// ------------------------------------------------------------

### POST send payment - Failed Unauthorized
POST {{host}}/payment
Content-Type: application/json

< ./validPaymentUnauthorized.json

### POST send payment - Failed Bank Service Unavailable
POST {{host}}/payment
Content-Type: application/json

< ./validPaymentBankServiceUnavailable.json

### POST send payment - Failed Expired
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentExpired.json

### POST send payment - Failed Unsupported Currency
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentUnsupportCurrency.json

### POST send payment - Failed Invalid Card number
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentCardNumber.json

### POST send payment - Failed All Field
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentNoValidField.json

### POST send payment - Failed Incorrect JSON field type
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentNoAnyCorrectFieldType.json

### POST send payment - Failed Invalid JSON
POST {{host}}/payment
Content-Type: application/json

< ./invalidPaymentJSON.json